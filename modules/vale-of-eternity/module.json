            }
          }
        ]
      }
    },
    {
      "id": "round",
      "label": "Round",
      "icon": "flag",
      "block": {
        "type": "flow",
        "title": "Round",
        "cyclic": true,
        "reminders": [
          "Max 4 magic stones each. If you end up with more, keep 4 and discard the rest right away.",
          "Areas you have = current round number. Remove cost = current round number.",
          "Overpaying gives no change. Stones can't be swapped with the supply unless a card says so.",
          "Every effect must be used (e.g. Medusa forces a discard if your hand isn't empty).",
          "If any part of an Instant effect can't be resolved, you can't summon that card.",
          "Card text beats the rulebook when they conflict.",
          "Game ends after a round in which anyone reaches 60+ points, or after round 10. Tie: most summoned cards wins."
        ],
        "newGameText": "Clears all your tracked cards and goes back to Hunting.",
        "setup": {
          "id": "setup",
          "title": "Setup",
          "summary": "Do this once, before round 1.",
          "listTitle": "Setup",
          "how": [
            "Each player takes 2 player markers and 1 player tile of their color.",
            "Shuffle all 70 cards into a draw pile. Leave space for a discard pile.",
            "Put the magic stones next to the score board as the supply."
          ],
          "checklist": [
            {
              "id": "setup.first",
              "text": "Pick the first player",
              "sub": "Whoever most recently saw a reptile. They take the first-player marker."
            },
            {
              "id": "setup.round",
              "text": "Round marker on space 1"
            },
            {
              "id": "setup.score",
              "text": "Set starting scores",
              "sub": "Turn order: first player 1 point, second 2, third 3, fourth 4."
            },
            {
              "id": "setup.app",
              "text": "Start a new game in the app",
              "sub": "Clears your tracked cards",
              "action": {
                "type": "newGame"
              }
            }
          ]
        },
        "children": [
          {
            "type": "step",
            "id": "hunting",
            "title": "Hunting",
            "summary": "Reveal 2 cards per player, then everyone drafts 2.",
            "listTitle": "Hunting",
            "how": [
              "Reveal 2 cards per player (4 / 6 / 8 for 2 / 3 / 4 players) from the draw pile and sort them by family around the board. If the pile runs out, shuffle the discards into a new pile.",
              "First pick goes CLOCKWISE from the first player: put a player marker on a card.",
              "Second pick goes COUNTERCLOCKWISE from the last player, so the last player picks two in a row.",
              "You can't pick a card that already has a marker on it."
            ],
            "checklist": [
              {
                "id": "hunting.reveal",
                "text": "Reveal 2 cards per player",
                "sub": "4 / 6 / 8 cards. Optional: add them to Table in the app"
              },
              {
                "id": "hunting.first",
                "text": "First picks: clockwise",
                "sub": "Starting with the first player"
              },
              {
                "id": "hunting.second",
                "text": "Second picks: counterclockwise",
                "sub": "Starting with the last player, who picks twice in a row"
              }
            ]
          },
          {
            "type": "step",
            "id": "action",
            "title": "Action",
            "summary": "In turn order, sell, tame, summon or remove, as often as you like.",
            "listTitle": "Before Resolution",
            "how": [
              "SELL: take your marker back, discard that card, gain stones by family (Fire 3 red · Water 1 blue · Earth 4 red · Wind 1 red + 1 blue · Dragon 1 purple). Cost doesn't matter.",
              "TAME: take your marker back and put that card in your hand. No hand limit; keep your hand secret.",
              "SUMMON: if your areas aren't full, pay the cost of a card in your hand, place it face up, then resolve its Instant effect.",
              "REMOVE: pay stones equal to the round number to discard one of your own summoned cards."
            ],
            "checklist": [
              {
                "id": "action.markers",
                "text": "Both markers are back",
                "sub": "Each hunted card was sold or tamed. You can't end your turn otherwise."
              },
              {
                "id": "action.stones",
                "text": "4 stones or fewer"
              },
              {
                "id": "action.app",
                "text": "App is up to date",
                "sub": "Tamed → Hand, summoned → Field, sold → removed"
              }
            ]
          },
          {
            "type": "step",
            "id": "resolution",
            "title": "Resolution",
            "summary": "Use every Active effect in your Field once, in any order.",
            "listTitle": "Your Active cards",
            "emptyText": "No Active cards in your Field. Nothing to resolve.",
            "how": [
              "Players resolve in turn order, starting with the first player.",
              "Every Active effect must be used, once per round.",
              "Order can matter, e.g. draw a card first, then score for hand size.",
              "'Recover' puts the summoned card back into its owner's hand."
            ],
            "checklist": [],
            "cardChecklist": {
              "collection": "cards",
              "filter": {
                "zone": "field",
                "where": [
                  {
                    "path": "effects.type",
                    "has": "active"
                  }
                ]
              },
              "sub": "{effects[type=active].text}"
            }
          },
          {
            "type": "step",
            "id": "end",
            "title": "End of round",
            "summary": "Clean up, then start the next round.",
            "listTitle": "Cleanup",
            "nextLabel": "Start next round",
            "how": [
              "Game ends if anyone has 60+ points, or round 10 just ended. Most points wins. Tie: most summoned cards wins; still tied, shared victory.",
              "If your score passes 60, flip your player tile.",
              "Next round you have 1 more area, and removing a card costs 1 more."
            ],
            "checklist": [
              {
                "id": "end.gameover",
                "text": "Check for game end",
                "sub": "Anyone at 60+ points, or was this round 10?"
              },
              {
                "id": "end.round",
                "text": "Move the round marker"
              },
              {
                "id": "end.first",
                "text": "Pass the first-player marker to the left"
              },
              {
                "id": "end.table",
                "text": "Clear Table in the app",
                "sub": "Removes the cards you tracked on Table",
                "action": {
                  "type": "clearZone",
                  "zone": "table"
                },
                "actionLabel": "Clear"
              }
            ]
          }
        ]
      }
    }
  ]
