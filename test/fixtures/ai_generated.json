      "block": {
        "type": "flow",
        "title": "Round",
        "cyclic": true,
        "reminders": [
          "Play a card that matches the top card's suit or rank.",
          "An 8 is wild: play it on anything and name a suit.",
          "Can't play? Draw from the stock until you can. If the stock is empty, pass.",
          "First player to empty their hand wins the round.",
          "2 players: 7 cards each. 3 to 5 players: 5 cards each. 6 to 7 players: shuffle two decks together, 5 cards each.",
          "Play to an agreed target score, commonly 100 points."
        ],
        "newGameText": "Clears the called suit.",
        "setup": {
          "id": "setup",
          "title": "Setup",
          "short": "Setup",
          "summary": "Shuffle, deal and turn up the starter card.",
          "listTitle": "Before the first turn",
          "how": [
            "Use one standard 52-card deck for 2 to 5 players.",
            "For 6 or 7 players, shuffle two 52-card decks together.",
            "Dealer changes each round, passing to the left."
          ],
          "checklist": [
            { "id": "setup.deck", "text": "Shuffle the deck", "sub": "One deck for 2 to 5 players, two decks for 6 to 7" },
            { "id": "setup.deal", "text": "Deal cards one at a time", "sub": "7 each with 2 players; 5 each with 3 or more players" },
            { "id": "setup.stock", "text": "Place the rest face down as the stock" },
            {
              "id": "setup.starter",
              "text": "Turn the top stock card face up to start the discard pile",
              "sub": "If it is an 8, bury it in the stock and turn up another"
            },
            {
              "id": "setup.clear",
              "text": "No suit is called yet",
              "action": { "type": "clearZone", "zone": "called" },
              "actionLabel": "Clear"
            }
          ]
        },
        "children": [
          {
            "type": "step",
            "id": "turn",
            "title": "Your turn",
            "short": "Turn",
            "summary": "Play one matching card, or draw.",
            "listTitle": "On your turn",
            "how": [
              "Play starts with the player to the dealer's left and goes clockwise.",
              "A card matches if it has the same suit or the same rank as the top discard.",
              "If an 8 was played, match the called suit instead (or play another 8).",
              "You may draw even if you could play. Keep drawing until you play a card.",
              "If the stock is empty and you cannot play, pass."
            ],
            "checklist": [
              { "id": "turn.match", "text": "Play a card matching suit or rank", "sub": "Or the called suit after an 8" },
              { "id": "turn.eight", "text": "Played an 8? Name a suit", "sub": "Track it on the Suit tab" },
              { "id": "turn.draw", "text": "Cannot play? Draw until you can", "sub": "Stock empty: pass" },
              {
                "id": "turn.clearcalled",
                "text": "Called suit followed? Clear it",
                "sub": "The called suit only applies to the card played on the 8",
                "action": { "type": "clearZone", "zone": "called" },
                "actionLabel": "Clear"
              }
            ]
          },
          {
            "type": "step",
            "id": "end",
            "title": "End of round",
            "short": "Score",
            "summary": "Someone went out, or nobody can play.",
            "listTitle": "Scoring",
            "nextLabel": "Next round",
            "how": [
              "The round ends when a player plays their last card.",
              "That player scores the cards left in every other player's hand.",
              "If the stock is empty and no one can play, the round is blocked. The player with the lowest hand total scores the difference from each other player.",
              "8 = 50, King/Queen/Jack/10 = 10, Ace = 1, other cards = face value."
            ],
            "checklist": [
              { "id": "end.count", "text": "Count cards left in the losers' hands", "sub": "8 = 50, K Q J 10 = 10, A = 1, others face value" },
